ent="1"><mxGeometry x="1018.0" y="243" width="14" height="14" as="geometry"/></mxCell><mxCell id="trunkdot" value="" style="ellipse;html=1;fillColor=#262626;strokeColor=#262626;" vertex="1" parent="1"><mxGeometry x="593.0" y="183" width="14" height="14" as="geometry"/></mxCell><mxCell id="key1" value="Each VLAN has its own subnet, and the router holds the gateway address for each one (router-on-a-stick)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#404040;" vertex="1" parent="1"><mxGeometry x="40" y="548" width="1120" height="22" as="geometry"/></mxCell><mxCell id="key2" value="Devices in different VLANs can only reach each other through the router. A Layer 3 switch would use one SVI per VLAN instead." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#404040;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="1120" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>