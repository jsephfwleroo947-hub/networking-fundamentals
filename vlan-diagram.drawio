<mxfile host="app.diagrams.net"><diagram id="vlan" name="One switch, three VLANs"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="One switch carved into three VLANs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="700" height="30" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=1;arcSize=4;dashed=1;fillColor=#EAF2FB;strokeColor=#2F5496;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="340" height="190" as="geometry"/></mxCell><mxCell id="v10t" value="VLAN 10: Staff" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#2F5496;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="340" height="20" as="geometry"/></mxCell><mxCell id="v10s" value="Subnet 10.10.10.0/24" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#2F5496;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="340" height="20" as="geometry"/></mxCell><mxCell id="v10g" value="Gateway 10.10.10.1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#2F5496;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="340" height="20" as="geometry"/></mxCell><mxCell id="v10a" value="Access ports (VLAN 10)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#2F5496;" vertex="1" parent="1"><mxGeometry x="130.0" y="298" width="160" height="28" as="geometry"/></mxCell><mxCell id="v20" value="" style="rounded=1;arcSize=4;dashed=1;fillColor=#EAF6EE;strokeColor=#2E7D4F;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="340" height="190" as=